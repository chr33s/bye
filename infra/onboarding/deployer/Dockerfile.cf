# Explicit cf migration image: build with -f infra/onboarding/deployer/Dockerfile.cf.
# The default Dockerfile remains available for the rollback release.
FROM node:24.18.1-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7 AS build
ARG BYE_RELEASE_COMMIT
RUN test -n "$BYE_RELEASE_COMMIT"
RUN npm install --global pnpm@12.8.1 && npm cache clean --force
WORKDIR /srv/bye
COPY . .
RUN pnpm install --frozen-lockfile && node -e "const fs=require('fs');for(const name of fs.readdirSync('node_modules/.pnpm'))if(name.startsWith('alchemy@'))fs.rmSync('node_modules/.pnpm/'+name,{recursive:true,force:true});fs.rmSync('node_modules/alchemy',{force:true});fs.rmSync('.alchemy',{recursive:true,force:true});fs.rmSync('.env',{force:true});"
FROM node:24.18.1-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7
ARG BYE_RELEASE_COMMIT
ENV BYE_RELEASE_DIR=/srv/bye BYE_RELEASE_COMMIT=$BYE_RELEASE_COMMIT PORT=8080 \
    CI=true BYE_DEPLOY_ENGINE=cf DO_NOT_TRACK=1 CF_SEND_TELEMETRY=false
RUN npm install --global pnpm@12.8.1 && npm cache clean --force
WORKDIR /srv/bye
COPY --from=build --chown=node:node /srv/bye .
USER node
EXPOSE 8080
CMD ["node", "--experimental-strip-types", "infra/onboarding/deployer/server.ts"]
