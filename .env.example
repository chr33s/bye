# Copy this file to .env, then export its values before running commands:
#   set -a; source .env; set +a
# The CLI does not load .env automatically. Use `bye login` to save credentials in user config.
BYE_API=http://localhost:8787
# BYE_TOKEN=
# BYE_MAILBOX=
# BYE_CALENDAR=

# Deployment settings. Copy values into your protected deployment environment before deploying.
# Do not commit real credentials. STAGE must be dev-<id>, preview-<n>, staging, or prod.
# STAGE=dev-your-name
# CLOUDFLARE_ACCOUNT_ID=
# Required token scopes: see infra/RUNBOOK.md, "Cloudflare deployment token".
# CLOUDFLARE_API_TOKEN=

# Required Worker origins. Replace these example hosts with your deployed domains.
# APP_ORIGIN=https://app.example.com
# MAIL_RENDER_ORIGIN=https://mail-render.example.com
# Optional custom domains: MailCore (APP_DOMAIN; also creates the Turnstile widget) and the public
# site (PUBLIC_DOMAIN). Empty = workers.dev on dev/preview stages.
# APP_DOMAIN=app.example.com
# PUBLIC_DOMAIN=example.com
# Service-owned inbound mail zone. Email Routing is enabled only once BYE_MX_CUTOVER=approved
# (RUNBOOK "MX cutover"); keep it unset for the first deploy.
# MAIL_ZONE=example.com
# BYE_MX_CUTOVER=

# Required secrets for the current stack configuration. Generate unique values (pnpm generate:key) and keep them in
# protected config. Mail provider credentials need separate approval before you use them.
# BILLING_WEBHOOK_SECRET=
# PROBE_TOKEN=
# PROXY_SIGNING_KEY=
# SESSION_KEY accepts a rotation ring, newest first: v2:<new>,v1:<old> (RUNBOOK "Secret rotation").
# SESSION_KEY=
# SIGMIRROR_WRITE_TOKEN=
# Operator token for the recovery routes in workers/core/src/routes/ops.ts; empty = disabled.
# OPS_TOKEN=

# Personal mail: add `personal` to MAIL_TRAFFIC_CLASSES to send it through Cloudflare Email Sending.
# MAIL_DKIM_PRIVATE_KEY (PKCS#8 PEM) signs it as selector bye1; MAIL_DKIM_PUBLIC_KEY is the matching
# base64 SPKI published by the domain workflow. Ephemeral stages need MAIL_SANDBOX_DOMAINS for either.
# MAIL_TRAFFIC_CLASSES=transactional,personal
# MAIL_DKIM_PRIVATE_KEY=
# Signing secret for /webhooks/send-events deliveries (t=,v1= scheme, >= 32 chars).
# SEND_EVENTS_WEBHOOK_SECRET=

# Staging/prod deploys holding any mail credential require the operator attestation that provider
# sent-email previews are off (RUNBOOK "Provider sent-email previews").
# PROVIDER_SENT_PREVIEWS=disabled

# Stage traffic classes MailTransport may dispatch (spec.md §5.3); empty = transactional only.
# MAIL_TRAFFIC_CLASSES=transactional,personal

# Newsletter provider (spec.md §5.5). Dispatch stays blocked until NEWSLETTER_QUALIFIED names the
# release-qualification evidence for this stage.
# NEWSLETTER_PROVIDER=resend
# NEWSLETTER_ACCOUNT=
# NEWSLETTER_QUALIFIED=
# NEWSLETTER_API_KEY=
# NEWSLETTER_WEBHOOK_SECRET=

# Cloudflare Turnstile secret of the SignupChallenge widget (RUNBOOK "First deploy: Turnstile").
# TURNSTILE_SECRET=

# Scanner signature source: mirror (default) or baked with a digest-pinned SCANNER_IMAGE.
# SCANNER_SIGNATURES=mirror
# SCANNER_IMAGE=ghcr.io/<owner>/<repo>/scanner@sha256:<digest>

# Optional strict Cloudflare-only deployment state backend (see infra/RUNBOOK.md). Use a token
# scoped to your stages (e.g. `preview-*|dev-*=<token>` on the backend); prod uses a separate
# backend or its own grant (CI: PROD_BYE_STATE_URL / PROD_BYE_STATE_TOKEN).
# STATE_BACKEND=http
# BYE_STATE_URL=https://state.example.com
# BYE_STATE_TOKEN=

# Optional mail sandbox for preview/dev stages when mail credentials are configured.
# MAIL_SANDBOX_DOMAINS=example.test
